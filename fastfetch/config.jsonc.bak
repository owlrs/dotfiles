{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": "->  ",
        "color": {
            "separator": "white" // Bold
        }
    },
    "modules": [
//        {
//            "key": "󰌢 Machine",
//            "keyColor": "yellow",
//            "type": "title",
//            "format": "ThinkPad X1 Carbon 6th (Notebook)"
//        },
        {
            "key": "{icon} Distro   ",
            "keyColor": "blue",
            "type": "os"
        },
        {
            "key": "{icon} DE (WM)  ",
            "keyColor": "magenta",
            "type": "wm"
        },
        {
            "key": "{icon} CPU      ",
            "keyColor": "green",
            "type": "cpu"
        },
        {
            "key": "{icon} GPU      ",
            "keyColor": "cyan",
            "type": "gpu"
        },
        {
            "key": "{icon} RAM      ",
            "keyColor": "yellow",
            "type": "memory"
        },
        {
            "key": "{icon} Uptime   ",
            "keyColor": "red",
            "type": "uptime"
        },
        {
            "key": "{icon} Monitor  ",
            "keyColor": "magenta",
            "type": "display"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
